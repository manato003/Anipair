# 「Annict でログイン」の設定の名前の一覧（値はここに書かない。実際の値は .env.local と Vercel の環境変数に置く）
#
# Annict のアプリケーション（https://annict.com/oauth/applications）を登録すると、client_id と client_secret が発行される。

# --- ブラウザに埋め込まれる（公開してよい）。無ければ「Annict でログイン」のボタンを出さず、個人用トークンの欄だけになる ---
VITE_ANNICT_CLIENT_ID=

# --- 以下は関数（api/annict-token.ts）だけが読む。Vercel の環境変数にだけ置く。VITE_ を付けない（付けると公開の JS に入る） ---
ANNICT_CLIENT_ID=
ANNICT_CLIENT_SECRET=
# 許可するリダイレクト先（カンマ区切り。末尾のスラッシュまで Annict の登録と同じにする）。例: https://（公開 URL）/,http://localhost:3000/
ANNICT_REDIRECT_URIS=

# --- 任意: 問い合わせの受け付け（api/feedback.ts）。無ければ受け付けない（503） ---
# 運営者の非公開リポジトリに Issue を作るトークン（Issues の Read and write だけ）と、リポジトリ名（owner/name）
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_REPO=

# --- 任意: Shikimori の公開データの控えと、問い合わせの回数の数え（api/shiki.ts。Upstash Redis）。無ければ控えなし・関数ごとに少なめの上限 ---
# Vercel の Upstash のつなぎ込みなら KV_REST_API_URL / KV_REST_API_TOKEN が入る（UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN でもよい）
KV_REST_API_URL=
KV_REST_API_TOKEN=
